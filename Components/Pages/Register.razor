@page "/register"
@inject TravelDataService TravelService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Register • PyramidX</PageTitle>

<div class="relative min-h-[calc(100vh-5rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <!-- Desert Background Glow -->
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 pointer-events-none"></div>
    <div class="absolute -top-32 -left-32 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-yellow-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-2xl w-full space-y-8">
        <!-- Header -->
        <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-amber-600 via-amber-500 to-yellow-300 text-slate-950 shadow-xl shadow-amber-500/25 mb-4 transform hover:scale-105 transition-transform">
                <svg class="w-10 h-10" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2L1 21h22L12 2zm0 3.84L19.35 19H12V5.84z"/>
                </svg>
            </div>
            <h2 class="font-serif text-3xl font-extrabold text-amber-400 tracking-wide">
                Join the Expedition
            </h2>
            <p class="mt-2 text-sm text-slate-400">
                Create your explorer account and personalize your PyramidX travel journey
            </p>
        </div>

        <!-- Registration Card Layout -->
        <div class="bg-slate-900/90 border border-amber-500/30 rounded-2xl shadow-2xl p-8 backdrop-blur-xl relative">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-amber-500 to-transparent rounded-t-2xl"></div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-6 p-4 rounded-xl bg-red-950/60 border border-red-500/50 flex items-start gap-3 text-red-200 text-sm">
                    <svg class="w-5 h-5 text-red-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span>@_errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="mb-6 p-4 rounded-xl bg-emerald-950/60 border border-emerald-500/50 flex items-start gap-3 text-emerald-200 text-sm">
                    <svg class="w-5 h-5 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <div>
                        <p class="font-semibold text-emerald-300">@_successMessage</p>
                        <p class="text-xs text-emerald-400 mt-1">Directing you to the portal dashboard...</p>
                    </div>
                </div>
            }

            <EditForm Model="@_registerModel" OnValidSubmit="HandleRegister" class="space-y-6">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Username -->
                    <div>
                        <label class="block text-xs font-semibold text-amber-300 uppercase tracking-wider mb-2">
                            Explorer Username
                        </label>
                        <div class="relative rounded-xl shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                            </div>
                            <InputText @bind-Value="_registerModel.Username"
                                       placeholder="e.g. NefertitiTravels"
                                       class="block w-full pl-11 pr-4 py-3 bg-slate-950/80 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition" />
                        </div>
                        <ValidationMessage For="@(() => _registerModel.Username)" class="validation-message" />
                    </div>

                    <!-- Email -->
                    <div>
                        <label class="block text-xs font-semibold text-amber-300 uppercase tracking-wider mb-2">
                            Email Address
                        </label>
                        <div class="relative rounded-xl shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
                                </svg>
                            </div>
                            <InputText @bind-Value="_registerModel.Email"
                                       placeholder="explorer@egypt.com"
                                       class="block w-full pl-11 pr-4 py-3 bg-slate-950/80 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition" />
                        </div>
                        <ValidationMessage For="@(() => _registerModel.Email)" class="validation-message" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Password -->
                    <div>
                        <label class="block text-xs font-semibold text-amber-300 uppercase tracking-wider mb-2">
                            Password
                        </label>
                        <div class="relative rounded-xl shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                            </div>
                            <InputText type="password" @bind-Value="_registerModel.Password"
                                       placeholder="Minimum 6 characters"
                                       class="block w-full pl-11 pr-4 py-3 bg-slate-950/80 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition" />
                        </div>
                        <ValidationMessage For="@(() => _registerModel.Password)" class="validation-message" />
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label class="block text-xs font-semibold text-amber-300 uppercase tracking-wider mb-2">
                            Confirm Password
                        </label>
                        <div class="relative rounded-xl shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                </svg>
                            </div>
                            <InputText type="password" @bind-Value="_registerModel.ConfirmPassword"
                                       placeholder="Repeat your password"
                                       class="block w-full pl-11 pr-4 py-3 bg-slate-950/80 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition" />
                        </div>
                        <ValidationMessage For="@(() => _registerModel.ConfirmPassword)" class="validation-message" />
                    </div>
                </div>

                <!-- Travel Interest Options / Tags -->
                <div class="pt-2">
                    <div class="flex items-center justify-between mb-3">
                        <label class="block text-xs font-semibold text-amber-300 uppercase tracking-wider">
                            Travel Interests & Preferences
                        </label>
                        <span class="text-xs text-slate-400">
                            @_selectedInterests.Count selected
                        </span>
                    </div>
                    <p class="text-xs text-slate-400 mb-4">
                        Select one or more travel styles to tailor your pyramid recommendations and personalized perks.
                    </p>

                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                        @foreach (var interest in _availableInterests)
                        {
                            var isSelected = _selectedInterests.Contains(interest.Name);
                            <button type="button"
                                    @onclick="() => ToggleInterest(interest.Name)"
                                    class="@(isSelected
                                        ? "bg-amber-500/20 border-amber-400 text-amber-300 shadow-sm shadow-amber-500/20"
                                        : "bg-slate-950/60 border-slate-800 text-slate-400 hover:border-slate-600 hover:text-slate-200")
                                        flex items-center gap-2 px-3 py-2.5 rounded-xl border text-xs font-medium transition-all text-left">
                                <span class="text-base">@interest.Icon</span>
                                <span class="truncate">@interest.Name</span>
                                @if (isSelected)
                                {
                                    <svg class="w-3.5 h-3.5 ml-auto text-amber-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                    </svg>
                                }
                            </button>
                        }
                    </div>
                </div>

                <!-- Terms Notice -->
                <div class="flex items-center gap-3 text-xs text-slate-400 bg-slate-950/40 p-3.5 rounded-xl border border-slate-800">
                    <input type="checkbox" checked disabled class="w-4 h-4 rounded bg-slate-900 border-slate-700 text-amber-500" />
                    <span>I agree to abide by UNESCO heritage preservation and respectful tourism protocols at all archaeological sites.</span>
                </div>

                <!-- Submit Button -->
                <button type="submit"
                        disabled="@_isSubmitting"
                        class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-slate-950 font-bold bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-400 hover:from-amber-400 hover:to-yellow-300 shadow-lg shadow-amber-500/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0 disabled:opacity-50">
                    @if (_isSubmitting)
                    {
                        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-slate-950" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                        </svg>
                        <span>Creating Account...</span>
                    }
                    else
                    {
                        <span>Complete Registration & Go to Dashboard</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    }
                </button>
            </EditForm>

            <!-- Link to Login -->
            <div class="mt-8 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-3">
                <span>Already have an explorer account?</span>
                <a href="login" class="font-semibold text-amber-400 hover:text-amber-300 underline-offset-4 hover:underline">
                    Sign in to your account →
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterViewModel _registerModel = new();
    private List<string> _selectedInterests = new() { "Ancient Archaeology", "Sunset & Night Spectacular" };
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isSubmitting = false;

    private readonly List<(string Name, string Icon)> _availableInterests = new()
    {
        ("Ancient Archaeology", "🏛️"),
        ("Photography & Drone", "📸"),
        ("Sunset & Night Spectacular", "🌅"),
        ("Camel & Desert Safari", "🐪"),
        ("VIP Pharaoh Tomb Access", "👑"),
        ("Hieroglyphic Workshops", "📜"),
        ("Nile River Cruise", "⛵"),
        ("Stargazing at Giza", "🌌")
    };

    private void ToggleInterest(string interest)
    {
        if (_selectedInterests.Contains(interest))
        {
            _selectedInterests.Remove(interest);
        }
        else
        {
            _selectedInterests.Add(interest);
        }
    }

    private async Task HandleRegister()
    {
        _isSubmitting = true;
        _errorMessage = null;

        if (_registerModel.Password != _registerModel.ConfirmPassword)
        {
            _errorMessage = "Passwords do not match. Please ensure both passwords are identical.";
            _isSubmitting = false;
            return;
        }

        var newUser = new User
        {
            Username = _registerModel.Username,
            Email = _registerModel.Email,
            Password = _registerModel.Password,
            Preferences = new List<string>(_selectedInterests)
        };

        if (TravelService.Register(newUser, out var error))
        {
            _successMessage = "Account created successfully! Welcome to the PyramidX Portal.";
            await Task.Delay(800);
            Navigation.NavigateTo("dashboard");
        }
        else
        {
            _errorMessage = error ?? "Failed to create account. Please check your information.";
            _isSubmitting = false;
        }
    }

    public class RegisterViewModel
    {
        [Required(ErrorMessage = "Username is required.")]
        [StringLength(30, MinimumLength = 3, ErrorMessage = "Username must be between 3 and 30 characters.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Please provide a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

