@inject TravelDataService TravelService
@inject NavigationManager Navigation
@implements IDisposable

<header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/85 border-b border-amber-500/20 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
            <!-- Brand Logo -->
            <a href="dashboard" class="flex items-center gap-3 group">
                <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-amber-600 via-amber-500 to-yellow-300 flex items-center justify-center shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform duration-300">
                    <!-- Stylized Pyramid SVG -->
                    <svg class="w-7 h-7 text-slate-950" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2L1 21h22L12 2zm0 3.84L19.35 19H12V5.84z"/>
                    </svg>
                </div>
                <div>
                    <span class="block font-serif font-bold text-xl tracking-wider text-amber-400 group-hover:text-amber-300 transition-colors">
                        PYRAMIDS OF EGYPT
                    </span>
                    <span class="block text-xs uppercase tracking-widest text-slate-400 font-medium">
                        Official Tourism Portal
                    </span>
                </div>
            </a>

            <!-- Desktop Navigation Links -->
            <nav class="hidden md:flex items-center gap-1 lg:gap-2">
                <NavLink href="dashboard" Match="NavLinkMatch.All"
                         class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-300 hover:text-amber-400 hover:bg-slate-900/60"
                         ActiveClass="!text-amber-400 !bg-amber-500/10 !border !border-amber-500/30">
                    <span class="flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                        Dashboard
                    </span>
                </NavLink>

                <NavLink href="login"
                         class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-300 hover:text-amber-400 hover:bg-slate-900/60"
                         ActiveClass="!text-amber-400 !bg-amber-500/10 !border !border-amber-500/30">
                    <span class="flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                        </svg>
                        Login
                    </span>
                </NavLink>

                <NavLink href="register"
                         class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-300 hover:text-amber-400 hover:bg-slate-900/60"
                         ActiveClass="!text-amber-400 !bg-amber-500/10 !border !border-amber-500/30">
                    <span class="flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                        </svg>
                        Register
                    </span>
                </NavLink>
            </nav>

            <!-- User Auth Actions -->
            <div class="hidden md:flex items-center gap-3">
                @if (TravelService.IsAuthenticated)
                {
                    <div class="flex items-center gap-3 bg-slate-900/80 border border-slate-800 rounded-xl px-3.5 py-1.5">
                        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-amber-500 to-amber-300 flex items-center justify-center font-bold text-xs text-slate-950 shadow">
                            @GetInitials(TravelService.CurrentUser?.Username)
                        </div>
                        <div class="text-left text-xs">
                            <span class="block text-slate-400">Explorer</span>
                            <span class="block font-semibold text-amber-400">@TravelService.CurrentUser?.Username</span>
                        </div>
                        <button @onclick="HandleLogout" title="Log Out"
                                class="ml-2 text-slate-400 hover:text-red-400 p-1.5 rounded-lg hover:bg-red-500/10 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                        </button>
                    </div>
                }
                else
                {
                    <a href="login" class="text-sm font-semibold text-slate-300 hover:text-amber-400 px-3 py-2 transition-colors">
                        Sign In
                    </a>
                    <a href="register"
                       class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold px-4 py-2 rounded-xl text-sm shadow-md shadow-amber-500/20 transition-all transform hover:-translate-y-0.5">
                        <span>Get Started</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </a>
                }
            </div>

            <!-- Mobile Menu Toggle Button -->
            <div class="flex md:hidden">
                <button @onclick="ToggleMobileMenu"
                        class="p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-amber-400">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        @if (_mobileMenuOpen)
                        {
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        }
                        else
                        {
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        }
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Dropdown -->
        @if (_mobileMenuOpen)
        {
            <div class="md:hidden py-4 border-t border-slate-800 space-y-2">
                <NavLink href="dashboard" Match="NavLinkMatch.All" @onclick="CloseMobileMenu"
                         class="block px-4 py-2.5 rounded-lg text-sm font-semibold text-slate-300 hover:bg-slate-900 hover:text-amber-400"
                         ActiveClass="!text-amber-400 !bg-amber-500/10">
                    Dashboard
                </NavLink>
                <NavLink href="login" @onclick="CloseMobileMenu"
                         class="block px-4 py-2.5 rounded-lg text-sm font-semibold text-slate-300 hover:bg-slate-900 hover:text-amber-400"
                         ActiveClass="!text-amber-400 !bg-amber-500/10">
                    Login
                </NavLink>
                <NavLink href="register" @onclick="CloseMobileMenu"
                         class="block px-4 py-2.5 rounded-lg text-sm font-semibold text-slate-300 hover:bg-slate-900 hover:text-amber-400"
                         ActiveClass="!text-amber-400 !bg-amber-500/10">
                    Register
                </NavLink>

                <div class="pt-2 border-t border-slate-800/80">
                    @if (TravelService.IsAuthenticated)
                    {
                        <div class="flex items-center justify-between px-4 py-2">
                            <span class="text-sm text-slate-300">Signed in as <strong class="text-amber-400">@TravelService.CurrentUser?.Username</strong></span>
                            <button @onclick="HandleLogout" class="text-xs text-red-400 hover:underline">Log Out</button>
                        </div>
                    }
                    else
                    {
                        <div class="px-4 pt-2">
                            <a href="register" @onclick="CloseMobileMenu"
                               class="w-full block text-center bg-amber-500 text-slate-950 font-bold py-2 rounded-lg text-sm">
                                Create Account
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</header>

@code {
    private bool _mobileMenuOpen = false;

    protected override void OnInitialized()
    {
        TravelService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        TravelService.OnChange -= StateHasChanged;
    }

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        _mobileMenuOpen = false;
    }

    private void HandleLogout()
    {
        TravelService.Logout();
        _mobileMenuOpen = false;
        Navigation.NavigateTo("login");
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "EG";
        return name.Length >= 2 ? name.Substring(0, 2).ToUpper() : name.ToUpper();
    }
}
